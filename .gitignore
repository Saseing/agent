# ── 密钥与配置（务必不要提交）────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# ── 运行时数据 ───────────────────────────────────────────────────────────────
uploads/
pang/
knowledge_base/
.tasks/
# 工作区登记表：里面存的是**本机绝对路径**（如 D:\dsh），属运行时状态，
# 换台机器就没意义，也不该把本机目录结构传上去。
.workspaces/
# Agent 生成的页面（工作区里的 pages/ 子目录）。当工作区就是本应用目录时，
# 产物会落在 ./pages/ —— 那是「做出来的东西」，不是源码，故不提交。
pages/
*.log

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 编辑器 / 系统 ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 本机私有资料（不随仓库发布）──────────────────────────────────────────────
# 只属于这台机器的东西统一收进 _local/，工作目录保持干净：
#   _local/reference/   参考文档（第三方手册等，可能涉及版权）
#   _local/legacy/      早期 hello_agents 示例与废弃代码（原 tests/ examples/ deprecated/）
#   _local/old-charts/  历史生成的图表（保留着，因为旧会话里的图片附件仍指向它们）
# 注：将来要写真正的测试，新建 tests/ 后把本行删掉即可（_local/legacy/tests 是旧的、无关的）。
_local/
