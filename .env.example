# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会被提交。
#
#   PowerShell:  Copy-Item .env.example .env

# ── 必填：模型与密钥 ─────────────────────────────────────────────────────────
# 这里用的是"OpenAI 兼容"协议，所以变量名沿用了 OPENAI_API_KEY ——
# 它只是"当前 LLM_BASE_URL 那个服务的密钥"，跟 OpenAI 无关。
# 示例：DeepSeek  → LLM_BASE_URL=https://api.deepseek.com        LLM_MODEL=deepseek-chat
#       DashScope → LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
OPENAI_API_KEY=sk-替换成你自己的密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=1

# 联网搜索（可选）。不填则 tavily_search 工具不可用，其余功能不受影响。
TAVILY_API_KEY=tvly-替换成你自己的密钥

# ── 可选：多 Agent 闭环里给 Planner / Judge 单独配模型 ──────────────────────
# 不配则回落到上面那套。可以做到"执行用便宜模型、评审用强模型"。
# PLANNER_MODEL=
# PLANNER_BASE_URL=
# PLANNER_API_KEY=
# JUDGE_MODEL=
# JUDGE_BASE_URL=
# JUDGE_API_KEY=

# ── 可选：服务与访问控制 ─────────────────────────────────────────────────────
# 默认只监听回环地址（仅本机可访问）。设为 0.0.0.0 才会对局域网开放，
# 此时请同时配置 CORS_ORIGINS，并注意 /settings/api 这个能改密钥的接口。
HOST=127.0.0.1
PORT=8001
# CORS_ORIGINS=http://192.168.1.10:8001
# 是否允许非本机来源调用 /settings/api 修改密钥（默认只允许本机）
# ALLOW_REMOTE_SETTINGS=0

# ── 危险开关 ─────────────────────────────────────────────────────────────────
# 设为 1 会让后端正则抓取模型回复里的 ```python``` 代码块并直接执行，默认关闭。
# AUTO_EXECUTE_CODE_BLOCKS=0
